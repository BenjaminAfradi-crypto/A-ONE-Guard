{
  "name": "a-one-guard",
  "private": true,
  "version": "0.0.0-pilot",
  "scripts": {
    "test": "npm run test:syntax && npm run test:unit",
    "test:syntax": "find . -maxdepth 1 -type f -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test:unit": "node --test tests/*.test.cjs",
    "test:browser": "node --test --test-concurrency=1 tests/*.browser.cjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
